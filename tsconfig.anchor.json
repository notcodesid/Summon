{
  "compilerOptions": {
    "types": ["mocha", "node"],
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "es2022",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "rootDir": ".",
    "skipLibCheck": true,
    "strict": true
  },
  "include": ["tests/anchor/**/*.ts", "target/types/**/*.ts"]
}
