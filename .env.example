# Client-safe env vars (bundled into the app via EXPO_PUBLIC_*).
# Copy to .env and fill in. Never commit .env.

# Supabase → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key

# Privy → Dashboard → App ID + Clients (public)
EXPO_PUBLIC_PRIVY_APP_ID=your_privy_app_id
EXPO_PUBLIC_PRIVY_CLIENT_ID=your_privy_client_id

# Optional: Privy custom Google OAuth provider id, e.g. custom:google.
# Required if you want Google profile pictures instead of initials.
EXPO_PUBLIC_PRIVY_GOOGLE_PROVIDER_ID=google

# Public legal and support links shown inside the app. Publish the checked-in
# PRIVACY.md and TERMS.md at these URLs before any beta release.
EXPO_PUBLIC_PRIVACY_URL=https://summon.app/privacy
EXPO_PUBLIC_TERMS_URL=https://summon.app/terms
EXPO_PUBLIC_SUPPORT_EMAIL=support@your-domain.com

# Identify + creature save go through Supabase Edge Functions.
# Gemini and service role keys stay on the server (never EXPO_PUBLIC_*).

# Solana game file (player PDA). Defaults to devnet 31PMr... when unset.
# The public devnet RPC is crowded and answers 429 — for steady testing use
# a free dedicated RPC (e.g. Helius devnet URL) here and as SOLANA_RPC_URL.
# EXPO_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
# EXPO_PUBLIC_SUMMON_PROGRAM_ID=31PMrc54Z6aZ8YHbm47FugFKpzUc6PJ92vNJtinBUPxN

# --- Server / Edge Function secrets ONLY (never ship in the mobile app) ---
# Supabase → Project Settings → Database → Connection string
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
# Privy app secret (admin / Edge Functions)
# PRIVY_APP_SECRET=your_privy_app_secret
# Gemini for Edge Function `identify` (set via: supabase secrets set GEMINI_API_KEY=...)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# PRIVY_APP_ID= (same as EXPO_PUBLIC_PRIVY_APP_ID; set as Edge secret)
# Sponsor wallet for Edge Function `drip` — base58 secret key, HOT wallet with
# small balance only (e.g. 5 SOL). Refill by hand from your vault. Never put
# this in EXPO_PUBLIC_* or the app binary.
# SPONSOR_PRIVATE_KEY=
# SOLANA_RPC_URL=https://api.devnet.solana.com
# DRIP_LAMPORTS=10000000
# SPONSOR_DAILY_CAP=100

# Real Google sign-in via Privy is the default. Set to 1 only for automated
# UI tests that cannot complete an OAuth flow — bypassed sessions have no
# Privy user id and no wallet, so nothing is saved to Supabase.
EXPO_PUBLIC_AUTH_BYPASS=0

# Dev only: seed the sanctuary with fake creatures so the home screen can be
# checked without a real camera. Render-only — never saved or uploaded.
EXPO_PUBLIC_DEV_MOCK_CREATURES=0
