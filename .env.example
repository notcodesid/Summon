# Client-safe env vars (bundled into the app via EXPO_PUBLIC_*).
# Copy to .env and fill in. Never commit .env.

# Supabase → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key

# Privy → Dashboard → App ID + Clients (public)
EXPO_PUBLIC_PRIVY_APP_ID=your_privy_app_id
EXPO_PUBLIC_PRIVY_CLIENT_ID=your_privy_client_id

# Animal identification (Claude vision). Leave unset to use the demo fallback.
# WARNING: this ships inside the app bundle — demo builds only. Move the call
# behind a server before distributing the app.
EXPO_PUBLIC_ANTHROPIC_API_KEY=

# --- Server / local scripts ONLY (never ship in the mobile app) ---
# Supabase → Project Settings → Database → Connection string
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
# Privy app secret (admin only)
# PRIVY_APP_SECRET=your_privy_app_secret

# Real Google sign-in via Privy is the default. Set to 1 only for automated
# UI tests that cannot complete an OAuth flow — bypassed sessions have no
# Privy user id and no wallet, so nothing is saved to Supabase.
EXPO_PUBLIC_AUTH_BYPASS=0
